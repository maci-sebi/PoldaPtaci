<Window x:Class="PoldaPtaci.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoldaPtaci"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="130" />
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Stretch="Fill">
            <Canvas x:Name="GameCanvas" Width="1920" Height="1080">
            </Canvas>
        </Viewbox>

        <Grid Grid.Row="1" Background="#1A1A1A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#444444" BorderThickness="2" Margin="10" Padding="15" Background="#0A0A0A" CornerRadius="5">
                <TextBlock x:Name="TxtDialog" 
                           Text="Detektiv: Musím najít vajíčka paní Kosi. Kde jen mohou být?" 
                           Foreground="Yellow" 
                           FontSize="20" 
                           FontFamily="Comic Sans MS" 
                           FontWeight="Bold"
                           TextWrapping="Wrap" 
                           VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Column="1" BorderBrush="#444444" BorderThickness="2" Margin="10" Background="#0A0A0A" CornerRadius="5">
                <Grid>
                    <TextBlock Text="INVENTÁŘ" Foreground="Gray" FontSize="12" FontFamily="Comic Sans MS" Margin="5,2,0,0" VerticalAlignment="Top"/>
                    <StackPanel Orientation="Horizontal" x:Name="InventoryPanel" Margin="10,20,10,10" VerticalAlignment="Center">
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
